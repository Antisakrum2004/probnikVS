#Region ОбщийМодуль.ВидеоконсультацииВызовСервера
#Область ПрограммныйИнтерфейс

// Клиентский прокси для серверных вызовов (чтобы не вызывать серверные напрямую с клиента)

// Отправить запрос на создание конференции (вызов сервера)
//
// Параметры:
//  sessionID        - Строка
//  personID         - Число
//  patientFullName  - Строка
//  spec_id          - Строка
//  doctorFullName   - Строка
//  specialization  - Строка
//  startTime        - Строка
//
// Возвращаемое значение:
//  Структура - ответ от middleware
//
&НаСервере
Функция СоздатьКонференциюВEmAIНаСервере(sessionID, personID, patientFullName, spec_id, doctorFullName, specialization, startTime) Экспорт
	Возврат ВидеоконсультацииСервер.СоздатьКонференциюВEmAI(sessionID, personID, patientFullName, spec_id, doctorFullName, specialization, startTime);
КонецФункции

// Отменить конференцию (вызов сервера)
//
&НаСервере
Функция ОтменитьКонференциюВEmAIНаСервере(sessionID, emaiSessionID, reason = "") Экспорт
	Возврат ВидеоконсультацииСервер.ОтменитьКонференциюВEmAI(sessionID, emaiSessionID, reason);
КонецФункции

// Завершить конференцию (вызов сервера)
//
&НаСервере
Функция ЗавершитьКонференциюВEmAIНаСервере(sessionID, emaiSessionID) Экспорт
	Возврат ВидеоконсультацииСервер.ЗавершитьКонференциюВEmAI(sessionID, emaiSessionID);
КонецФункции

// Открыть ссылку в системном браузере
//
&НаКлиенте
Процедура ОткрытьСсылкуВБраузере(СсылкаВК) Экспорт
	Попытка
		ЗапуститьПриложение(СсылкаВК);
	Исключение
		ПоказатьПредупреждение(, "Не удалось открыть браузер. Скопируйте ссылку вручную: " + СсылкаВК);
	КонецПопытки;
КонецПроцедуры

// Найти активную консультацию (вызов сервера)
//
&НаСервере
Функция НайтиАктивнуюКонсультациюНаСервере(Врач, Пациент) Экспорт
	Возврат ВидеоконсультацииСервер.НайтиАктивнуюКонсультацию(Врач, Пациент);
КонецФункции

// Обновить статус в регистре (вызов сервера)
//
&НаСервере
Процедура ОбновитьСтатусВРегистреНаСервере(sessionID, ПриемЗапланирован, ПриемПроведен) Экспорт
	ВидеоконсультацииСервер.ОбновитьСтатусВРегистре(sessionID, ПриемЗапланирован, ПриемПроведен);
КонецПроцедуры

#КонецОбласти
#EndRegion
