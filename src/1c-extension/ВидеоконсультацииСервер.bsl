#Region ОбщийМодуль.ВидеоконсультацииСервер
#Область ПрограммныйИнтерфейс

// Выполняет HTTP POST запрос к middleware и возвращает ответ как Структуру
//
// Параметры:
//  Endpoint  - Строка - путь к эндпоинту middleware (например, "?action=create")
//  Payload   - Структура - тело запроса, будет сериализовано в JSON
//
// Возвращаемое значение:
//  Структура - ответ от middleware:
//    * success - Булево
//    * status  - Число (HTTP код)
//    * message - Строка
//    * data    - Структура (при успехе)
//
Функция ВыполнитьЗапросКMiddleware(Endpoint, Payload) Экспорт
	
	Настройки = ПолучитьНастройкиПодключения();
	ПолныйURL = Настройки.URLMiddleware + "/" + Endpoint;
	
	// Сериализация payload в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	СтрокаДанныхJSON = "";
	ЗаписьJSON.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьJSON(ЗаписьJSON, Payload);
	СтрокаДанныхJSON = ЗаписьJSON.Закрыть();
	
	// HTTP запрос
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	HTTPЗапрос = Новый HTTPЗапрос(Endpoint, Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаДанныхJSON);
	
	SSL = Новый ЗащищенноеСоединениеOpenSSL(Новый СертификатКлиентаX509(), Новый СертификатУдостоверяющегоЦентраX509());
	
	Попытка
		Соединение = Новый HTTPСоединение(
			Настройки.ХостMiddleware,
			Настройки.ПортMiddleware,
			, , , // Пользователь, Пароль, Прокси
			,    // Таймаут (по умолчанию)
			SSL  // Для HTTPS; для HTTP - Новый ОпределениеИнтернетПрокси()
		);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(HTTPОтвет.ПолучитьТелоКакСтроку());
		
		ОтветСтруктура = СериализаторXDTO.ПрочитатьJSON(ЧтениеJSON);
		
		Возврат ОтветСтруктура;
		
	Исключение
		Возврат Новый Структура(
			"success, status, message, data",
			Ложь, 0,
			"Ошибка подключения к серверу: " + ОписаниеОшибки(),
			Неопределено
		);
	КонецПопытки;
	
КонецФункции

// Создаёт запись в регистре "УчетВидеоконсультаций"
//
// Параметры:
//  ДокументСсылка - ДокументСсылка - ссылка на документ "Запись на приём"
//  sessionID      - Строка - идентификатор сессии
//  emaiSessionID  - Число  - идентификатор от EmAI
//  СсылкаВК       - Строка - готовая ссылка с JWT для врача
//  ДатаКонсульт   - Дата   - дата/время консультации
//
Процедура СоздатьЗаписьВРегистре(ДокументСсылка, sessionID, emaiSessionID, СсылкаВК, ДатаКонсульт, КодПациента, ФИОПациента, КодСотрудника, ФИОВрача, Ставка) Экспорт
	
	НаборЗаписей = РегистрыСведений.УчетВидеоконсультаций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСессии.Установить(sessionID);
	
	Запись = НаборЗаписей.Добавить();
	Запись.ИдентификаторСессии = sessionID;
	Запись.КодПациента         = КодПациента;
	Запись.ФИОПациента         = ФИОПациента;
	Запись.КодСотрудника       = КодСотрудника;
	Запись.ФИОВрача            = ФИОВрача;
	Запись.Ставка              = Ставка;
	Запись.ТипКонсультации     = "video";
	Запись.ДатаВремяКонсультации = ДатаКонсульт;
	Запись.ИдентификаторEmAI   = emaiSessionID;
	Запись.СсылкаНаВидеоконсультацию = СсылкаВК;
	Запись.ПриемЗапланирован   = Истина;
	Запись.ПриемПроведен       = Ложь;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Найти активную (запланированную) запись в регистре по врачу и пациенту
//
// Параметры:
//  Врач    - СправочникСсылка.Сотрудники
//  Пациент - СправочникСсылка.ФизическиеЛица
//
// Возвращаемое значение:
//  Структура - данные записи или Неопределено
//
Функция НайтиАктивнуюКонсультацию(Врач, Пациент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УчетВидеоконсультаций.ИдентификаторСессии КАК ИдентификаторСессии,
		|	УчетВидеоконсультаций.ИдентификаторEmAI КАК ИдентификаторEmAI,
		|	УчетВидеоконсультаций.СсылкаНаВидеоконсультацию КАК СсылкаВК,
		|	УчетВидеоконсультаций.ФИОВрача КАК ФИОВрача,
		|	УчетВидеоконсультаций.ФИОПациента КАК ФИОПациента
		|ИЗ
		|	РегистрСведений.УчетВидеоконсультаций КАК УчетВидеоконсультаций
		|ГДЕ
		|	УчетВидеоконсультаций.КодСотрудника = &КодСотрудника
		|	И УчетВидеоконсультаций.КодПациента = &КодПациента
		|	И УчетВидеоконсультаций.ПриемЗапланирован = ИСТИНА
		|	И УчетВидеоконсультаций.ПриемПроведен = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	УчетВидеоконсультаций.ДатаВремяКонсультации УБЫВ";
	
	Запрос.УстановитьПараметр("КодСотрудника", Строка(Врач.Код));
	Запрос.УстановитьПараметр("КодПациента", Строка(Пациент.Код));
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Новый Структура(
		"ИдентификаторСессии, ИдентификаторEmAI, СсылкаВК, ФИОВрача, ФИОПациента",
		Выборка.ИдентификаторСессии,
		Выборка.ИдентификаторEmAI,
		Выборка.СсылкаВК,
		Выборка.ФИОВрача,
		Выборка.ФИОПациента
	);
	
КонецФункции

// Обновить флаги в регистре по sessionID
//
// Параметры:
//  sessionID        - Строка - идентификатор сессии
//  ПриемЗапланирован - Булево - новое значение флага
//  ПриемПроведен    - Булево - новое значение флага
//
Процедура ОбновитьСтатусВРегистре(sessionID, ПриемЗапланирован, ПриемПроведен) Экспорт
	
	НаборЗаписей = РегистрыСведений.УчетВидеоконсультаций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ИдентификаторСессии.Установить(sessionID);
	НаборЗаписей.Прочитать();
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ПриемЗапланирован = ПриемЗапланирован;
		Запись.ПриемПроведен     = ПриемПроведен;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Отправить запрос на создание конференции в EmAI (через middleware)
//
// Параметры:
//  sessionID        - Строка - ID сессии 1С
//  personID         - Число  - код пациента
//  patientFullName  - Строка - ФИО пациента
//  spec_id          - Строка - код специальности врача
//  doctorFullName   - Строка - ФИО врача
//  specialization  - Строка - название специальности
//  startTime        - Строка - дата/время начала (ISO 8601)
//
// Возвращаемое значение:
//  Структура - ответ от middleware
//
Функция СоздатьКонференциюВEmAI(sessionID, personID, patientFullName, spec_id, doctorFullName, specialization, startTime) Экспорт
	
	Payload = Новый Структура;
	Payload.Вставить("sessionID",        sessionID);
	Payload.Вставить("personID",         personID);
	Payload.Вставить("patientFullName",  patientFullName);
	Payload.Вставить("spec_id",          spec_id);
	Payload.Вставить("doctorFullName",   doctorFullName);
	Payload.Вставить("specialization",   specialization);
	Payload.Вставить("consultationType", "video");
	Payload.Вставить("startTime",        startTime);
	Payload.Вставить("ttlMinutes",       60);
	
	Возврат ВыполнитьЗапросКMiddleware("?action=create", Payload);
	
КонецФункции

// Отправить событие отмены конференции в EmAI
//
Функция ОтменитьКонференциюВEmAI(sessionID, emaiSessionID, reason = "") Экспорт
	
	Payload = Новый Структура;
	Payload.Вставить("sessionID",     sessionID);
	Payload.Вставить("emaiSessionID", Строка(emaiSessionID));
	Payload.Вставить("action",        "CANCEL");
	Payload.Вставить("eventTime",     Формат(ТекущаяДатаСеанса(), "Л=ru_RU; ДФ=yyyy-MM-ddThh:mm:ss") + "Z");
	
	Если ЗначениеЗаполнено(reason) Тогда
		Payload.Вставить("reason", reason);
	КонецЕсли;
	
	Возврат ВыполнитьЗапросКMiddleware("?action=cancel", Payload);
	
КонецФункции

// Отправить событие завершения конференции в EmAI
//
Функция ЗавершитьКонференциюВEmAI(sessionID, emaiSessionID) Экспорт
	
	Payload = Новый Структура;
	Payload.Вставить("sessionID",     sessionID);
	Payload.Вставить("emaiSessionID", Строка(emaiSessionID));
	Payload.Вставить("action",        "COMPLETE");
	Payload.Вставить("eventTime",     Формат(ТекущаяДатаСеанса(), "Л=ru_RU; ДФ=yyyy-MM-ddThh:mm:ss") + "Z");
	
	Возврат ВыполнитьЗапросКMiddleware("?action=complete", Payload);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получить настройки подключения к middleware
// В production — читать из Констант расширения
Функция ПолучитьНастройкиПодключения()
	
	Результат = Новый Структура;
	
	// URL middleware (без слэша на конце)
	Результат.Вставить("URLMiddleware", "http://msi-2.dialog.ip:58080");
	
	// Парсинг хоста и порта
	СтрокаСоединения = "msi-2.dialog.ip:58080";
	ПозицияДвоеточия = Найти(СтрокаСоединения, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Вставить("ХостMiddleware", Лев(СтрокаСоединения, ПозицияДвоеточия - 1));
		Результат.Вставить("ПортMiddleware", Число(Сред(СтрокаСоединения, ПозицияДвоеточия + 1)));
	Иначе
		Результат.Вставить("ХостMiddleware", СтрокаСоединения);
		Результат.Вставить("ПортMiddleware", 80);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
#EndRegion
