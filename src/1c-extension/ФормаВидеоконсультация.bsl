#Region ОбработкаВидеоконсультация
// ====================================
//  Обработка «Видеоконсультация» (АРМ Врача)
//  Форма обработки
// ====================================

// Реквизиты формы:
//   Врач    — СправочникСсылка.Сотрудники (элемент формы "Врач")
//   Пациент — СправочникСсылка.ФизическиеЛица (элемент формы "Пациент")
//
// Команды формы:
//   НачатьВидеоконсультацию  — открывает Jitsi в браузере
//   ЗавершитьКонсультацию    — отправляет COMPLETE в EmAI

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НачатьВидеоконсультацию(Команда)
	
	// Валидация
	Если НЕ ЗначениеЗаполнено(Объект.Врач) Тогда
		ПоказатьПредупреждение(, "Выберите врача.");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Пациент) Тогда
		ПоказатьПредупреждение(, "Выберите пациента.");
		Возврат;
	КонецЕсли;
	
	// Поиск активной консультации на сервере
	ДанныеКонсультации = ВидеоконсультацииВызовСервера.НайтиАктивнуюКонсультациюНаСервере(
		Объект.Врач, Объект.Пациент);
	
	Если ДанныеКонсультации = Неопределено Тогда
		ПоказатьПредупреждение(, 
			"Не найдена запланированная видеоконсультация для данного врача и пациента." + Символы.ПС +
			"Проверьте, что документ «Запись на приём» проведён и ссылка получена от EmAI.");
		Возврат;
	КонецЕсли;
	
	// Проверяем наличие ссылки
	Если НЕ ЗначениеЗаполнено(ДанныеКонсультации.СсылкаВК) Тогда
		ПоказатьПредупреждение(, 
			"Ссылка на видеоконсультацию не сформирована. Обратитесь к регистратору.");
		Возврат;
	КонецЕсли;
	
	// Сохраняем данные в реквизиты формы для завершения
	Объект.Расш1_SessionID     = ДанныеКонсультации.ИдентификаторСессии;
	Объект.Расш1_EmaiSessionID = ДанныеКонсультации.ИдентификаторEmAI;
	
	// Открываем в системном браузере
	ВидеоконсультацииВызовСервера.ОткрытьСсылкуВБраузере(ДанныеКонсультации.СсылкаВК);
	
	// Активируем кнопку завершения
	Элементы.ЗавершитьКонсультацию.Доступность = Истина;
	
	// Информационное сообщение
	ПоказатьОповещениеПользователя("Видеоконсультация", ,
		"Консультация запущена. Для завершения нажмите ""Завершить консультацию"".",
		БиблиотекаКартинок.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьКонсультацию(Команда)
	
	// Подтверждение
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Расш1_ПодтверждениеЗавершенияПослеЗакрытияОкна", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, 
		"Завершить видеоконсультацию? Соединение с пациентом будет разорвано.",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПодтверждениеЗавершенияПослеЗакрытияОкна(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// Отправляем завершение на сервер
	Ответ = ВидеоконсультацииВызовСервера.ЗавершитьКонференциюВEmAIНаСервере(
		Объект.Расш1_SessionID, Объект.Расш1_EmaiSessionID);
	
	Если Ответ.success Тогда
		// Обновляем регистр
		ВидеоконсультацииВызовСервера.ОбновитьСтатусВРегистреНаСервере(
			Объект.Расш1_SessionID, Ложь, Истина);
		
		Элементы.ЗавершитьКонсультацию.Доступность = Ложь;
		
		ПоказатьОповещениеПользователя("Видеоконсультация", ,
			"Консультация завершена и зафиксирована в МИС.",
			БиблиотекаКартинок.Информация);
	Иначе
		ПоказатьПредупреждение(, 
			"Ошибка завершения конференции: " + Ответ.message + Символы.ПС +
			"Пожалуйста, повторите попытку или обратитесь к администратору.");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Region ИнициализацияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Добавляем временные реквизиты (если не созданы в расширении)
	Если НЕ Объект.Метаданные().Реквизиты.Найти("Расш1_SessionID") Тогда
		// Реквизиты должны быть описаны в метаданных расширения
	КонецЕсли;
	
	// Кнопка завершения недоступна до начала консультации
	Элементы.ЗавершитьКонсультацию.Доступность = Ложь;
	
КонецПроцедуры

#EndRegion
#EndRegion
