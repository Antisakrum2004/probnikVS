#Region ФормаДокументаЗаписьНаПрием
// ====================================
//  Расширение формы документа «Запись на приём»
//  Добавляет логику видеоконсультаций
// ====================================

// Элементы формы (создаются в расширении):
//   - Видеоконсультация (ПолеФормы / переключатель)
//   - СтатусСEmAI (ПолеФормы / текст, только чтение)
//   - ОтправитьВEmAI (Кнопка / команда формы)

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура Расш1_ОтправитьВEmAI(Команда)
	
	// Валидация: галка должна стоять
	Если НЕ Объект.Расш1_Видеоконсультация Тогда
		ПоказатьПредупреждение(, "Установите галку ""Видеоконсультация"" перед отправкой.");
		Возврат;
	КонецЕсли;
	
	// Собираем данные из формы
	sessionID       = Строка(Объект.Ссылка.УникальныйИдентификатор());
	personID        = Объект.Пациент.Код;
	patientFullName = Объект.Пациент.НаименованиеПолное;
	spec_id         = Объект.Специалист.Код;
	doctorFullName  = Объект.Специалист.НаименованиеПолное;
	specialization  = "";
	startTime       = Формат(Объект.ДатаНачала, "Л=ru_RU; ДФ=yyyy-MM-ddThh:mm:ss") + "Z";
	
	// Вызов сервера
	Ответ = ВидеоконсультацииВызовСервера.СоздатьКонференциюВEmAIНаСервере(
		sessionID, personID, patientFullName, spec_id, doctorFullName, specialization, startTime);
	
	// Обработка ответа
	Если Ответ.success Тогда
		Элементы.СтатусСEmAI.Заголовок = Ответ.message;
		Элементы.СтатусСEmAI.ЦветФона = ЦветаСтиля.ЦветФонаПоляВводаПоложительногоРезультата;
		
		// Сохраняем emaiSessionID и ссылку во временные реквизиты формы
		// (запись в регистр произойдёт при проведении документа)
		Объект.Расш1_EmaiSessionID = Ответ.data.emaiSessionID;
		Объект.Расш1_СсылкаВК       = Ответ.data.doctorLink;
		
		ПоказатьОповещениеПользователя("Видеоконсультация", , 
			"Конференция создана. EmAI Session ID: " + Ответ.data.emaiSessionID, 
			БиблиотекаКартинок.Информация);
	Иначе
		Элементы.СтатусСEmAI.Заголовок = "ОШИБКА: " + Ответ.message;
		Элементы.СтатусСEmAI.ЦветФона = ЦветаСтиля.ЦветФонаПоляВводаОтрицательногоРезультата;
		
		ПоказатьПредупреждение(, "Ошибка создания конференции: " + Ответ.message);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ВидеоконсультацияПриИзменении(Элемент)
	
	// При снятии галки — очистить статус
	Если НЕ Объект.Расш1_Видеоконсультация Тогда
		Элементы.СтатусСEmAI.Заголовок = "";
		Объект.Расш1_EmaiSessionID = 0;
		Объект.Расш1_СсылкаВК       = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийПроведения

&НаСервере
Процедура Расш1_ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Если не видеоконсультация — стандартная логика
	Если НЕ Объект.Расш1_Видеоконсультация Тогда
		Возврат;
	КонецЕсли;
	
	// Если не было успешного ответа от EmAI — блокируем проведение
	Если Объект.Расш1_EmaiSessionID = 0 Тогда
		Отказ = Истина;
		Сообщить("Невозможно провести документ: не получен идентификатор от EmAI. Нажмите ""Отправить в EmAI"".", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;
	
	// Создаём запись в регистре
	Попытка
		ВидеоконсультацииСервер.СоздатьЗаписьВРегистре(
			Строка(Объект.Ссылка.УникальныйИдентификатор()),
			Строка(Объект.Ссылка.УникальныйИдентификатор()),
			Объект.Расш1_EmaiSessionID,
			Объект.Расш1_СсылкаВК,
			Объект.ДатаНачала,
			Объект.Пациент.Код,
			Объект.Пациент.НаименованиеПолное,
			Объект.Специалист.Код,
			Объект.Специалист.НаименованиеПолное,
			Объект.ДолжностнаяСтавка
		);
	Исключение
		Отказ = Истина;
		Сообщить("Ошибка записи в регистр видеоконсультаций: " + ОписаниеОшибки(), СтатусСообщения.Важное);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти
#EndRegion
