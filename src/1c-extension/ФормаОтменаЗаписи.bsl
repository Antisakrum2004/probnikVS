#Region ФормаДокументаОтменаЗаписи
// ====================================
//  Расширение формы документа «Отмена записи на приём»
//  Добавляет логику отмены видеоконсультации
// ====================================

// Элементы формы:
//   - ОтправитьОтменуВEmAI (Кнопка / команда формы)
//   - СтатусОтменыEmAI (ПолеФормы / текст, только чтение)

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура Расш1_ОтправитьОтменуВEmAI(Команда)
	
	// Ищем запись в регистре по связи с отменяемым документом
	sessionID = Строка(Объект.ДокументЗаписьНаПрием.УникальныйИдентификатор());
	ДанныеКонсультации = Неопределено;
	
	// Получаем данные с сервера
	ДанныеКонсультации = ПолучитьДанныеКонсультацииНаСервере(sessionID);
	
	Если ДанныеКонсультации = Неопределено Тогда
		ПоказатьПредупреждение(, "Не найдена активная видеоконсультация для данной записи.");
		Возврат;
	КонецЕсли;
	
	// Подтверждение пользователю
	ОписаниеОповещения = Новый ОписаниеОповещения(
		"Расш1_ПодтверждениеОтменыПослеЗакрытияОкна", ЭтотОбъект);
	ТекстВопроса = СтрШаблон(
		"Вы уверены, что хотите отменить видеоконсультацию?%1" +
		"Врач: %2%1" +
		"Пациент: %3",
		Символы.ПС,
		ДанныеКонсультации.ФИОВрача,
		ДанныеКонсультации.ФИОПациента
	);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура Расш1_ПодтверждениеОтменыПослеЗакрытияОкна(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	// Отправляем отмену
	Ответ = ВыполнитьОтменуНаСервере(Объект.Расш1_SessionID, Объект.Расш1_EmaiSessionID);
	
	Если Ответ.success Тогда
		Элементы.СтатусОтменыEmAI.Заголовок = "Консультация отменена: " + Ответ.message;
		Элементы.СтатусОтменыEmAI.ЦветФона = ЦветаСтиля.ЦветФонаПоляВводаПоложительногоРезультата;
		
		// Обновляем регистр
		ВидеоконсультацииВызовСервера.ОбновитьСтатусВРегистреНаСервере(
			Объект.Расш1_SessionID, Ложь, Ложь);
		
		ПоказатьОповещениеПользователя("Видеоконсультация", , 
			"Консультация отменена в EmAI.", 
			БиблиотекаКартинок.Информация);
	Иначе
		Элементы.СтатусОтменыEmAI.Заголовок = "ОШИБКА отмены: " + Ответ.message;
		Элементы.СтатусОтменыEmAI.ЦветФона = ЦветаСтиля.ЦветФонаПоляВводаОтрицательногоРезультата;
		
		ПоказатьПредупреждение(, "Ошибка отмены конференции: " + Ответ.message);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеПроцедурыИФункции

&НаСервере
Функция ПолучитьДанныеКонсультацииНаСервере(sessionID)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УчетВидеоконсультаций.ИдентификаторСессии КАК ИдентификаторСессии,
		|	УчетВидеоконсультаций.ИдентификаторEmAI КАК ИдентификаторEmAI,
		|	УчетВидеоконсультаций.ФИОВрача КАК ФИОВрача,
		|	УчетВидеоконсультаций.ФИОПациента КАК ФИОПациента
		|ИЗ
		|	РегистрСведений.УчетВидеоконсультаций КАК УчетВидеоконсультаций
		|ГДЕ
		|	УчетВидеоконсультаций.ИдентификаторСессии = &ИдентификаторСессии
		|	И УчетВидеоконсультаций.ПриемЗапланирован = ИСТИНА";
	
	Запрос.УстановитьПараметр("ИдентификаторСессии", sessionID);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	// Сохраняем в реквизиты формы для последующего использования
	Объект.Расш1_SessionID      = Выборка.ИдентификаторСессии;
	Объект.Расш1_EmaiSessionID   = Выборка.ИдентификаторEmAI;
	
	Возврат Новый Структура(
		"ИдентификаторСессии, ИдентификаторEmAI, ФИОВрача, ФИОПациента",
		Выборка.ИдентификаторСессии,
		Выборка.ИдентификаторEmAI,
		Выборка.ФИОВрача,
		Выборка.ФИОПациента
	);
	
КонецФункции

&НаСервере
Функция ВыполнитьОтменуНаСервере(sessionID, emaiSessionID)
	Возврат ВидеоконсультацииСервер.ОтменитьКонференциюВEmAI(sessionID, emaiSessionID);
КонецФункции

#КонецОбласти
#EndRegion
