# ============================================================
#  .env для Jitsi Meet (self-hosted)
#  Файл должен лежать РЯДОМ с docker-compose.yml
# ============================================================

# --- Версия образа ---
JITSI_IMAGE_VERSION=stable

# --- Пути ---
CONFIG=./jitsi-meet-cfg

# --- Сеть ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Основные настройки ---
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt

# --- JWT Авторизация ---
JWT_APP_ID=test_jitsi_app_id
JWT_APP_SECRET=test_jitsi_app_secret
JWT_ACCEPTED_ISSUERS=test_jitsi_app_id
JWT_ACCEPTED_AUDIENCES=jitsi-meet
JWT_ASAP_KEYSERVER=https://msi-2.dialog.ip:58443/
JWT_ALLOW_EMPTY=0
JWT_AUTH_TYPE=token
JWT_TOKEN_AUTH_INCLUDE_SUB=true

# --- Включить токен-аутентификацию ---
TOKEN_AUTH_URL=http://msi-2.dialog.ip:58080/

# --- Prosody ---
PUBLIC_URL=https://msi-2.dialog.ip:58443
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_BOSH_URL_BASE=https://msi-2.dialog.ip:58443/http-bind
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
JICOFO_COMPONENT_SECRET=jicofo-secret-change-me-in-production
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=jvb-secret-change-me-in-production

# --- Jitsi Videobridge ---
JVB_PORT=10000
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302

# --- TURN (NAT traversal) ---
# Если сервер за NAT — ОБЯЗАТЕЛЬНО нужен TURN сервер
# Вариант 1: Встроенный coturn (добавить в docker-compose)
# ENABLE_COTURN=1
# Вариант 2: Внешний (Google, Twilio)
JVB_ADVERTISE_IPS=msi-2.dialog.ip

# --- Запись (Jibri) ---
# Пока отключено (Вопрос 4 — не нужно)
# ENABLE_RECORDING=1
# XMPP_RECORDER_DOMAIN=recorder.meet.jitsi

# --- Чтение из .env PHP (для token-api) ---
EMAI_API_URL=https://emai-dev.comprog.art/api/gateway
EMAI_API_KEY=emai_dev_7f3a9c2e4b8d1a5f6c0e9b2d7a4f1c8e

# --- SSL ---
# Для Let's Encrypt (если есть домен):
# ENABLE_LETSENCRYPT=1
# LETSENCRYPT_DOMAIN=video.yourdomain.kz
# LETSENCRYPT_EMAIL=admin@yourdomain.kz
# PUBLIC_URL=https://video.yourdomain.kz

# --- Прокси ---
DISABLE_HTTPS=1  # Если SSL терминируется на nginx перед Jitsi
